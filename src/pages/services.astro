---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ServicesDetail from '../components/ServicesDetail.astro';
import ServiceHighlights from '../components/ServiceHighlights.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { servicesFaqs } from '../data/faqs';
---

<Layout
  title="Dental Services in Pickerington, OH | Cross Creeks Dental"
  description="Dental services in Pickerington, OH: cleanings, extractions, implants, dentures, Invisalign, deep cleaning, and cosmetic dentistry. Most insurance accepted."
>
  <Navigation />
  <main class="flex-grow">
    <ServicesDetail />
    <ServiceHighlights />
    <BeforeAfterGallery />
    <Faq heading="Frequently Asked Questions" items={servicesFaqs} />
  </main>
  <Footer />
</Layout>
