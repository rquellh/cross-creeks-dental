---
import { Phone, MapPin, Clock } from 'lucide-react';
import businessInfo from '../data/businessInfo.json';
import Button from './Button.astro';
import { telHref } from '../utils/contactLinks';
import { openHours } from '../data/faqs';

// Broken teeth and lost fillings or crowns are deliberately not listed here:
// the practice does not treat them as emergencies (see the note under the list).
const emergencies = [
  'A severe or lasting toothache',
  'Swelling in your face or gums, or a painful bump on the gum that may be an abscess',
  'A knocked-out tooth, or a tooth that has been knocked loose',
  'An injury to your gums or mouth',
];

const firstAid = [
  {
    title: 'Knocked-Out Tooth',
    text: "Pick the tooth up by the top (the crown), not the root. If it's dirty, rinse it gently with water, but don't scrub it. Keep it moist in a small container of milk and call us right away, because getting to a dentist quickly matters.",
  },
  {
    title: 'Toothache',
    text: "Rinse your mouth with warm water and gently floss to remove any food caught around the tooth. Don't put aspirin or other pain relievers directly on your gums or tooth, as this can burn the gum tissue. Then give us a call.",
  },
];

const urgentSigns = [
  'Trouble breathing or swallowing',
  "Bleeding that won't stop",
  'A serious injury to your face or jaw',
];

const officeHours = [
  { days: 'Monday - Thursday', hours: openHours },
  { days: 'Friday - Sunday', hours: 'Closed' },
];

const linkClass = 'font-medium text-brand-deep underline underline-offset-2 whitespace-nowrap hover:text-brand-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-medium focus-visible:ring-offset-2 transition-colors';
const sectionHeading = 'text-4xl md:text-5xl font-bold text-brand-deep text-center font-heading';
const sectionIntro = 'text-center text-gray-600 mb-12 max-w-2xl mx-auto';
const contactCard = 'bg-white px-4 py-6 sm:p-6 rounded-lg shadow-sm text-center';
const contactIcon = 'flex justify-center mb-4 text-brand-deep';
const contactTitle = 'text-xl font-bold text-brand-deep mb-2';
---

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-brand-deep mb-4 text-center font-heading">
      Emergency Dental Care
    </h1>
    <p class="text-center text-gray-600 mb-8 max-w-2xl mx-auto">
      Dental emergencies can happen anytime. We offer same-day emergency appointments for new and existing patients during office hours, so if you have a severe toothache, swelling or an injury to your mouth, call us right away.
    </p>
    <Button href={telHref}>
      <Phone className="inline-block w-5 h-5 mr-2 -mt-0.5" aria-hidden="true" />
      Call {businessInfo.phone}
    </Button>
    <p class="text-sm text-gray-600 mt-4 max-w-2xl mx-auto">
      Already a patient? When the office is closed, call the same number and choose the emergency option from the phone menu.
    </p>
  </div>
</section>

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class={`${sectionHeading} mb-4`}>
      What Counts as a Dental Emergency?
    </h2>
    <p class={sectionIntro}>
      Call us right away if you have any of the following:
    </p>

    <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm max-w-3xl mx-auto">
      <ul class="space-y-3">
        {emergencies.map((item) => (
          <li class="flex items-start text-gray-700">
            <span class="mt-2 mr-3 h-2 w-2 rounded-full bg-brand-medium flex-shrink-0" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="max-w-2xl mx-auto mt-8 space-y-4 text-center text-gray-600">
      <p>
        A broken, chipped or cracked tooth, or a lost filling or crown, is usually not an emergency, but it still needs care. Call us during office hours to schedule a visit.
      </p>
      <p>
        If you're not sure whether something is an emergency, give us a call.
      </p>
    </div>
  </div>
</section>

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class={`${sectionHeading} mb-4`}>
      What to Do in a Dental Emergency
    </h2>
    <div class="max-w-2xl mx-auto mb-12 space-y-4 text-center text-gray-600">
      <p>
        During office hours (Monday - Thursday, {openHours}), call <a href={telHref} class={linkClass}>{businessInfo.phone}</a> and let us know you have a dental emergency. We offer same-day emergency appointments, whether you're a new patient or we've seen you before.
      </p>
      <p>
        If you're a patient of our practice and need us after hours, call <a href={telHref} class={linkClass}>{businessInfo.phone}</a> and choose the emergency option from the phone menu.
      </p>
      <p>
        New to our office? Call us when we open to ask for a same-day emergency appointment.
      </p>
      <p>
        Until you can be seen, these steps may help:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {firstAid.map((tip) => (
        <div class="bg-white p-6 rounded-lg shadow-sm">
          <h3 class="text-xl font-bold text-brand-deep mb-3">
            {tip.title}
          </h3>
          <p class="text-gray-700 leading-relaxed">
            {tip.text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class={`${sectionHeading} mb-4`}>
      When to Go to the Emergency Room or Urgent Care
    </h2>
    <p class={sectionIntro}>
      Some problems need medical care right away. Go to the nearest emergency room or urgent care if you have:
    </p>

    <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm max-w-3xl mx-auto">
      <ul class="space-y-3">
        {urgentSigns.map((item) => (
          <li class="flex items-start text-gray-700">
            <span class="mt-2 mr-3 h-2 w-2 rounded-full bg-brand-medium flex-shrink-0" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <p class="text-center text-gray-600 mt-8 max-w-2xl mx-auto">
      Once you've been treated, call us about any dental care you still need.
    </p>
  </div>
</section>

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class={`${sectionHeading} mb-12`}>
      How to Reach Us
    </h2>

    {/* Two columns with the hours card spanning below them until xl, where three cards are wide enough
        for each hours row to stay on one line */}
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 max-w-6xl mx-auto">
      <div class={contactCard}>
        <div class={contactIcon}>
          <Phone size={32} />
        </div>
        <h3 class={contactTitle}>Phone</h3>
        <p class="text-gray-600">
          <a href={telHref} class={linkClass}>{businessInfo.phone}</a>
        </p>
      </div>

      <div class={contactCard}>
        <div class={contactIcon}>
          <MapPin size={32} />
        </div>
        <h3 class={contactTitle}>Address</h3>
        <p class="text-gray-600">
          {businessInfo.address.street}<br />
          {businessInfo.address.city}, {businessInfo.address.state} {businessInfo.address.zip}
        </p>
      </div>

      <div class={`${contactCard} md:col-span-2 xl:col-span-1`}>
        <div class={contactIcon}>
          <Clock size={32} />
        </div>
        <h3 class={contactTitle}>Office Hours</h3>
        {/* Day left, time right; below 360px a row cannot fit on one line, so the time drops under the day */}
        <dl class="grid grid-cols-[auto_auto] justify-between gap-x-3 gap-y-1 w-full max-w-xs mx-auto text-gray-600 max-[359px]:grid-cols-1 max-[359px]:justify-center">
          {officeHours.map((row) => (
            <Fragment>
              <dt class="text-left whitespace-nowrap max-[359px]:text-center">{row.days}</dt>
              <dd class="text-right whitespace-nowrap max-[359px]:text-center max-[359px]:mb-2">{row.hours}</dd>
            </Fragment>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
