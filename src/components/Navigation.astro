---
import logo from '../assets/images/logo.svg';
import Button from './Button.astro';
import businessInfo from '../data/businessInfo.json';
import { telHref } from '../utils/contactLinks';

const PHONE_ICON = '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>';

const NAV_ITEMS = [
  { href: '/', label: 'Home', icon: '<path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
  { href: '/team', label: 'Our Team', icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { href: '/services', label: 'Services', icon: '<path d="M12 3l1.912 5.813h6.124l-4.974 3.587 1.912 5.813L12 14.626l-4.974 3.587 1.912-5.813L3.964 8.813h6.124z"/>' },
  { href: '/insurance', label: 'Insurance', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' },
  { href: '/payments', label: 'Payments', icon: '<rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>' },
  { href: '/emergency-dentist/', label: 'Emergency', icon: '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>' },
  { href: '/contact', label: 'Contact', icon: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>' },
];
---

<nav class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center gap-3 h-20">
      <!-- The logo may shrink on narrow phones so the call and menu buttons always fit -->
      <div class="min-w-0 lg:flex-shrink-0">
        <a href="/" class="block">
          <img src={logo.src} alt="Cross Creeks Dental" class="h-12 w-auto max-w-full object-contain object-left" />
        </a>
      </div>

      <!-- Desktop Navigation: no Home link (the logo goes home) and tighter spacing below xl, so the bar stays on one line -->
      <div class="hidden lg:flex items-center space-x-6 xl:space-x-8">
        {NAV_ITEMS.filter((item) => item.href !== '/').map((item) => (
          <a
            href={item.href}
            class="text-brand-deep hover:text-brand-medium focus-visible:text-brand-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-medium focus-visible:ring-offset-2 active:text-brand-deep active:scale-[0.98] transition-all duration-200 font-medium"
          >
            {item.label}
          </a>
        ))}
        <Button
          href="https://booking.adit.com/fdb30dd3-549e-48dd-89aa-f3fa2b9a5f2d"
          target="_blank"
          rel="noopener noreferrer"
        >
          Schedule Online
        </Button>
      </div>

      <!-- Mobile Call + Menu Buttons -->
      <div class="flex flex-shrink-0 items-center gap-1 lg:hidden">
        <a
          href={telHref}
          class="inline-flex items-center justify-center w-11 h-11 rounded-md text-text-dark hover:text-brand-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-medium focus-visible:ring-offset-2 active:text-brand-deep transition-colors"
          aria-label={`Call ${businessInfo.name} at ${businessInfo.phone}`}
        >
          <svg class="h-6 w-6" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <Fragment set:html={PHONE_ICON} />
          </svg>
        </a>
        <button
          id="mobile-menu-btn"
          class="text-text-dark hover:text-brand-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-medium focus-visible:ring-offset-2 active:text-brand-deep transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" stroke="currentColor">
            <path id="menu-icon-open" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" d="M6 18L18 6M6 6l12 12" class="hidden" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Panel -->
  <div id="mobile-menu-panel" class="lg:hidden hidden absolute top-full left-0 right-0 max-h-[calc(100dvh-5rem)] overflow-y-auto bg-white shadow-lg border-t border-gray-200 z-50">
    <div class="max-w-7xl mx-auto px-4 py-4">
      <div class="bg-white rounded-2xl border border-gray-200 p-4 space-y-2">
        {NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class="flex items-center gap-3 text-text-dark hover:text-brand-medium hover:bg-bg-off-white focus-visible:text-brand-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-medium focus-visible:ring-offset-2 active:text-brand-deep active:bg-brand-deep/10 active:scale-[0.98] transition-all duration-200 px-4 py-3 rounded-lg"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <Fragment set:html={item.icon} />
            </svg>
            <span class="font-medium">{item.label}</span>
          </a>
        ))}
        <div class="pt-2 flex flex-col gap-2">
          <a
            href={telHref}
            class="flex items-center justify-center gap-2 w-full px-6 py-3 rounded-md font-semibold transition-all duration-200 text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-medium focus-visible:ring-offset-2 border-2 border-brand-deep text-brand-deep hover:bg-brand-deep/10 active:bg-brand-deep/20"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <Fragment set:html={PHONE_ICON} />
            </svg>
            Call {businessInfo.phone}
          </a>
          <a
            href="https://booking.adit.com/fdb30dd3-549e-48dd-89aa-f3fa2b9a5f2d"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block w-full px-6 py-3 rounded-md font-semibold transition-all duration-200 text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-medium focus-visible:ring-offset-2 bg-brand-deep text-white hover:bg-brand-medium active:bg-brand-deep active:scale-95"
          >
            Schedule Online
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !panel?.classList.contains('hidden');
    panel?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
